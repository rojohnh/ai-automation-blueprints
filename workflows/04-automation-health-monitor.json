{
  "name": "04 - Automation Health Monitor (grouped alerts, escalation rule)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "d4000000-0000-4000-8000-000000000001",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -460,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.N8N_API_BASE_URL }}/api/v1/executions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "error"
            },
            {
              "name": "limit",
              "value": "100"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "d4000000-0000-4000-8000-000000000002",
      "name": "Fetch Failed Executions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -240,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "N8N_API_CREDENTIAL_ID",
          "name": "n8n Public API (X-N8N-API-KEY)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#ops-alerts",
          "mode": "name"
        },
        "text": "=:see_no_evil: *The health monitor itself could not reach the n8n API.*\nTreat automation health as UNKNOWN until this clears.\n*Execution:* {{ $execution.id }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "d4000000-0000-4000-8000-000000000003",
      "name": "Alert: Monitor Blind",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        -20,
        460
      ],
      "credentials": {
        "slackApi": {
          "id": "SLACK_CREDENTIAL_ID",
          "name": "Slack (ops bot)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// An alert per failed execution is how a channel gets muted. Group by workflow,\n// count, and let the escalation rule below decide what deserves a human at 2am.\nconst executions = $input.first().json.data ?? [];\n\nconst byWorkflow = new Map();\nfor (const exec of executions) {\n  const key = exec.workflowId;\n  if (!byWorkflow.has(key)) {\n    byWorkflow.set(key, {\n      workflowId: key,\n      workflowName: exec.workflowName ?? exec.workflowData?.name ?? key,\n      count: 0,\n      firstSeen: exec.startedAt,\n      lastSeen: exec.startedAt,\n      sampleExecutionId: exec.id,\n      sampleError: (exec.lastNodeExecuted ? 'node: ' + exec.lastNodeExecuted : 'unknown node'),\n    });\n  }\n  const entry = byWorkflow.get(key);\n  entry.count += 1;\n  entry.lastSeen = exec.startedAt;\n}\n\nconst failures = [...byWorkflow.values()].sort((a, b) => b.count - a.count);\n\n// Escalate when one workflow is failing repeatedly - that is a broken integration,\n// not a transient blip that will clear on its own.\nconst ESCALATE_AT = 3;\nconst escalating = failures.filter((f) => f.count >= ESCALATE_AT);\n\nreturn [{\n  json: {\n    windowMinutes: 15,\n    checkedAt: new Date().toISOString(),\n    totalFailures: executions.length,\n    affectedWorkflows: failures.length,\n    failures,\n    escalating,\n    shouldEscalate: escalating.length > 0,\n    hasFailures: executions.length > 0,\n    summaryLine: failures\n      .map((f) => f.workflowName + ' x' + f.count)\n      .join(', ') || 'none',\n  },\n}];"
      },
      "id": "d4000000-0000-4000-8000-000000000004",
      "name": "Summarise Failures",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-has-failures",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.hasFailures }}",
              "rightValue": ""
            }
          ],
          "combinator": "or"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "d4000000-0000-4000-8000-000000000005",
      "name": "Any Failures?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        200,
        240
      ]
    },
    {
      "parameters": {},
      "id": "d4000000-0000-4000-8000-000000000006",
      "name": "All Healthy",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        420,
        380
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO automation_health (\n  checked_at, window_minutes, total_failures, affected_workflows, detail\n)\nVALUES ($1, $2, $3, $4, $5::jsonb);",
        "options": {
          "queryReplacement": "={{ [$json.checkedAt, $json.windowMinutes, $json.totalFailures, $json.affectedWorkflows, JSON.stringify($json.failures)] }}"
        }
      },
      "id": "d4000000-0000-4000-8000-000000000007",
      "name": "Record Health Sample",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        420,
        160
      ],
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#ops-alerts",
          "mode": "name"
        },
        "text": "=:chart_with_downwards_trend: *Automation failures in the last {{ $('Summarise Failures').first().json.windowMinutes }} minutes*\n*Total:* {{ $('Summarise Failures').first().json.totalFailures }} across {{ $('Summarise Failures').first().json.affectedWorkflows }} workflow(s)\n*Breakdown:* {{ $('Summarise Failures').first().json.summaryLine }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "d4000000-0000-4000-8000-000000000008",
      "name": "Notify Ops Channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        640,
        160
      ],
      "credentials": {
        "slackApi": {
          "id": "SLACK_CREDENTIAL_ID",
          "name": "Slack (ops bot)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-escalate",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $('Summarise Failures').first().json.shouldEscalate }}",
              "rightValue": ""
            }
          ],
          "combinator": "or"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "d4000000-0000-4000-8000-000000000009",
      "name": "Escalate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        860,
        160
      ]
    },
    {
      "parameters": {},
      "id": "d4000000-0000-4000-8000-00000000000a",
      "name": "Logged Only",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1080,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PAGER_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ severity: 'warning', source: 'n8n-health-monitor', summary: 'Repeated automation failures: ' + $('Summarise Failures').first().json.escalating.map(f => f.workflowName + ' x' + f.count).join(', '), detail: $('Summarise Failures').first().json.escalating }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "d4000000-0000-4000-8000-00000000000b",
      "name": "Page On-Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        60
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
